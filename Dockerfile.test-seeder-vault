# Dockerfile.test-seeder-vault
# Container that seeds HashiCorp Vault with test credentials

FROM hashicorp/vault:1.15

RUN apk add --no-cache \
    bash \
    curl \
    jq \
    openssl \
    coreutils \
    && rm -rf /var/cache/apk/*

# Create output directory
RUN mkdir -p /output

# Copy seed script
COPY scripts/seed-vault-hcv.sh /usr/local/bin/seed-vault-hcv.sh
RUN chmod +x /usr/local/bin/seed-vault-hcv.sh

# Set environment
ENV OUTPUT_DIR=/output

# Run the seeder
CMD ["/usr/local/bin/seed-vault-hcv.sh"]
